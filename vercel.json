{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/scan?cron=sentinel",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/architect"
    },
    {
      "source": "/api/pipeline/simulate",
      "destination": "/api/pipeline"
    },
    {
      "source": "/api/github/info",
      "destination": "/api/scan"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
